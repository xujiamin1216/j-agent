# j-agent configuration
# Copy to .env and fill in your values

# LLM provider: "claude" or "openai"
J_AGENT_PROVIDER=claude

# API key (required, unified for all providers)
J_AGENT_API_KEY=your-api-key-here

# Base URL (optional, for custom endpoints / proxies)
# If not set, the provider SDK uses its default endpoint
# J_AGENT_BASE_URL=https://api.anthropic.com

# Model identifier (optional, defaults are provided per provider)
# J_AGENT_MODEL=claude-sonnet-4-20250514

# Max tokens per response (optional, default 4096)
# J_AGENT_MAX_TOKENS=4096

# Custom system prompt (optional)
# J_AGENT_SYSTEM_PROMPT=You are a helpful assistant.

# Max context tokens before truncation/compression (optional, default 100000)
# J_AGENT_MAX_CONTEXT_TOKENS=100000

# Compress ratio: cut position for context compression (optional, default 0.6)
# J_AGENT_COMPRESS_RATIO=0.6

# Summary ratio: max summary length as fraction of threshold (optional, default 0.1)
# J_AGENT_SUMMARY_RATIO=0.1
